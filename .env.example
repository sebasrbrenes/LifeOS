# Copy to .env.local and fill in. Never commit real values.
# See docs/SETUP.md for where each value comes from.

# Public URL of this app (used for auth email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" (legacy) or "publishable" key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Integrations (optional). Server-only: NEVER prefix with NEXT_PUBLIC_. ---
# Each provider shows "Sin configurar" until its variables are set.
# See docs/SETUP.md#integrations.

# Supabase → Settings → API → service_role. Writes provider data and
# encrypted tokens on the server only.
# SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# Strava → https://www.strava.com/settings/api
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google Health API isn't onboarding new projects (spec §16).
# GOOGLE_HEALTH_ENABLED=false
# Scheduled sync (Vercel Cron). At least 32 characters.
# CRON_SECRET=
# Redirect URIs are derived from NEXT_PUBLIC_APP_URL:
#   <APP_URL>/integrations/strava/callback
#   <APP_URL>/integrations/google_calendar/callback
# Optional AI coach (Phase 11). Only sends a closed week's summary, and only
# when you press "Generar análisis".
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
